            type="text"
            id="search"
            placeholder="Search your favorite wallpaper..."
        >
    </section>

    <!-- WALLPAPER GALLERY -->
    <main>

        <h2>Explore Our Wallpapers</h2>

        <p class="description">
            Choose your favorite wallpaper and download it.
        </p>

        <div id="wallpaper-container" class="gallery">
            <!-- Wallpapers will appear here using JavaScript -->
        </div>

    </main>

    <!-- ABOUT SECTION -->
    <section class="about">
        <h2>About KAGENGU</h2>

        <p>
            KAGENGU WALLPAPER is a beautiful platform
            where you can find amazing wallpapers
            for your PC, Phone and other devices.
        </p>
    </section>

    <!-- CONTACT SECTION -->
    <section class="contact">
        <h2>Contact Us</h2>

        <p>phone num=0795444924

          email:kagenguwallpaper23@gmail.com
          
          om</p>
        <p>Website: KAGENGU WALLPAPER</p>
    </section>

    <!-- FOOTER -->
    <footer>
        <h3>KAGENGU WALLPAPER</h3>

        <p>Make your screen beautiful.</p>

        <p>
            &copy; 2026 KAGENGU WALLPAPER.
            All Rights Reserved.
        </p>
    </footer>

    <!-- JAVASCRIPT -->
