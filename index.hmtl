
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KAGENGU WALLPAPER</title>

    <meta name="description" content="Kagengu Wallpaper - Download beautiful wallpapers for PC and Phone.">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->
    <header>
        <h1>KAGENGU <span>WALLPAPER</span></h1>
        <p>Your world of beautiful wallpapers</p>
    </header>

    <!-- NAVIGATION -->
    <nav>
        <button class="active" data-category="All">Home</button>
        <button data-category="PC">PC Wallpapers</button>
        <button data-category="Phone">Phone Wallpapers</button>
        <button data-category="Nature">Nature</button>
        <button data-category="Cars">Cars</button>
        <button data-category="Animals">Animals</button>
